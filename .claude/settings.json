{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-presentation-freshness.sh\"",
            "if": "Bash(git push*)",
            "statusMessage": "Checking docs/presentation.html is up to date..."
          }
        ]
      }
    ]
  }
}
